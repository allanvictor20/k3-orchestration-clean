# Copy this file to .env and fill in your API keys
# Run: copy .env.example .env  (Windows)

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...
PERPLEXITY_API_KEY=pplx-...
SUNBIRD_API_KEY=your-sunbird-token-here

# Optional: for MCP web-search tool
BRAVE_API_KEY=your-brave-api-key

# Port the FastAPI server listens on
ORCHESTRATION_PORT=8716
